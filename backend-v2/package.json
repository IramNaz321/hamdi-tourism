{
  "name": "hamdi-v2-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local src/main.ts",
    "start": "tsx --env-file-if-exists=.env.local src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test tsx --env-file=.env.local --test tests/*.test.ts",
    "supabase": "supabase",
    "db:start": "supabase start --exclude studio,pgmeta,realtime,storage-api,imgproxy,edge-runtime,logflare,vector,supavisor",
    "db:stop": "supabase stop",
    "setup": "tsx scripts/setup-local.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "11.2.1",
    "@supabase/supabase-js": "2.118.0",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "supabase": "2.121.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
