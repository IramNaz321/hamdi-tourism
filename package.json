{
  "name": "hamdi-tourism",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:db": "bash supabase/tests/run.sh",
    "test:browser": "playwright test",
    "format": "prettier --write src tests *.ts *.mjs *.json *.md docs .github",
    "check:supabase": "tsx scripts/check-supabase.ts",
    "db:reference": "tsx scripts/database/reference.ts",
    "db:audit": "tsx scripts/database/audit.ts",
    "db:owner": "tsx scripts/database/owner.ts",
    "db:baseline": "tsx scripts/database/baseline.ts",
    "check:owner": "tsx scripts/check-owner-session.ts",
    "db:driver-migration": "tsx scripts/database/driver-migration.ts",
    "db:passenger-migration": "tsx scripts/database/passenger-migration.ts",
    "check:hosted": "tsx scripts/verification/hosted.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.0",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.80.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "stripe": "^23.0.0",
    "svix": "^2.8.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=24.0.0 <25"
