# Supabase Project Settings > API. Never use a service-role key as the publishable key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Server-only: Auth invitations, public media signing and CAPTCHA-validated enquiry ingestion.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
# Actual organization UUID produced by the real-owner bootstrap. No fictional default.
HAMDI_ORGANIZATION_ID=
# Exact public origin. Must match Supabase Auth Site URL/redirects and Turnstile hostname.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Real Cloudflare Turnstile keys. Leave unset until configured; never put the secret in browser code.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Contact information, logo, branding and policies are owner-managed in PostgreSQL Business Settings.

# Optional trusted operations tooling only, not required by the running application.
# Secure project database URI (verified TLS); never commit the actual value.
SUPABASE_DB_URL=
# Optional short-lived genuine owner session for read-only acceptance.
HAMDI_OWNER_ACCESS_TOKEN=

# Passenger registration requires client approval, Auth email confirmation and abuse controls.
PASSENGER_AUTH_ENABLED=false
# Server-only Stripe. Test-mode keys until client approves live payments and UAE eligibility.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVE_PAYMENTS_APPROVED=false
# Server-only AI; select a real permitted model and set provider spending limits.
OPENAI_CONCIERGE_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
AI_RATE_LIMIT_SECRET=
# Optional Resend delivery adapter. Do not enable without approved provider/domain and sending approval.
NOTIFICATION_EMAIL_ENABLED=false
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
NOTIFICATION_FROM=
NOTIFICATION_WORKER_SECRET=
