# Supabase Project Settings > API. The publishable key is public; never use a service role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Server only. Needed solely for owner invitations; never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
# Exact public origin; configure matching Supabase Auth redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Real client contact details; leave unset until provided. No fictional defaults.
NEXT_PUBLIC_BUSINESS_EMAIL=
NEXT_PUBLIC_BUSINESS_PHONE=
